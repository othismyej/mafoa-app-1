# Copier ce fichier en .env puis adapter. Ne jamais commiter .env.

# --- Django ---
# Générer une clé : python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=a-remplacer
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
SESSION_COOKIE_AGE=28800
# Double authentification (TOTP) : facultative par défaut en dev, toujours forcée en prod.
MFA_REQUIRED=false

# --- Base de l'application ---
# En docker compose, DATABASE_URL et REDIS_URL sont surchargées automatiquement.
DATABASE_URL=postgres://mafoa:mafoa@localhost:5432/mafoa
REDIS_URL=redis://localhost:6379/0

# --- Intégration site ---
# fixture (données fictives) | database | api
SITE_SOURCE=fixture
SITE_SOURCE_FIXTURE_SEED=20260101
# Visionneuse des pièces : taille maximale (octets, 20 Mo) et délai de lecture (secondes).
PIECE_VIEWER_MAX_BYTES=20971520
PIECE_SOURCE_TIMEOUT=10

# --- IA (API Claude) ---
# Clé personnelle à créer sur https://platform.claude.com (jamais commitée : .env est ignoré).
# Vide = « IA non configurée » : aucune lecture de pièce, aucun appel.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# Remplace nom, CIN, téléphone et email par des jetons avant tout envoi à l'IA.
AI_PSEUDONYMIZE=true
AI_EFFORT=medium
# Repli automatique côté serveur si le modèle refuse une demande (désactiver pour un modèle
# qui ne le prend pas en charge).
AI_FALLBACKS=true
AI_TIMEOUT=120
# Lecture des pièces (KAN-41). Les scans et images ne sont pas pseudonymisables : la vision
# reste désactivée tant que AI_PSEUDONYMIZE=true, sauf autorisation explicite ci-dessous.
AI_VISION_NON_PSEUDONYMISEE=false
AI_PIECE_MAX_BYTES=10485760
AI_PDF_MAX_PAGES=20
AI_TEXTE_MIN_CARACTERES=80
AI_TEXTE_MAX_CARACTERES=60000
AI_CONFIANCE_MIN=0.7
AI_LECTURE_APRES_SYNC=true
AI_LECTURE_ATTENTE_MAX_MINUTES=30

# Nombre de proxys de confiance devant l'app (0 en local ; 1 derrière un load balancer).
TRUSTED_PROXY_COUNT=0
# Plafond de lignes d'un export du journal d'audit (KAN-14).
AUDIT_EXPORT_MAX_ROWS=50000
# Plafond de candidatures par export Excel d'un poste ou d'un concours (KAN-37).
EXPORT_CANDIDATURES_MAX_ROWS=20000
# Actions en lot (KAN-15) : plafond d'un lot et seuil au-delà duquel la relance
# d'éligibilité passe en tâche de fond (Celery).
LOT_TAILLE_MAX=500
LOT_ELIGIBILITE_SYNC_MAX=50

# --- Production uniquement ---
# DJANGO_SETTINGS_MODULE=config.settings.prod
# DEFAULT_FROM_EMAIL=no-reply@example.com

# Candidatures spontanées : durée de conservation en mois (KAN-39, purge par KAN-31)
RETENTION_CANDIDATURE_SPONTANEE_MOIS=24
